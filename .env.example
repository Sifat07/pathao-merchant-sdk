# Pathao SDK Environment Variables
# Copy this file to .env and fill in your actual values

# Base URL - REQUIRED (choose one):
# For sandbox/testing:
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com

# For live/production:
# PATHAO_BASE_URL=https://api-hermes.pathao.com

# Authentication credentials (all required)
PATHAO_CLIENT_ID=your-client-id
PATHAO_CLIENT_SECRET=your-client-secret
PATHAO_USERNAME=your-username
PATHAO_PASSWORD=your-password

# Your default store ID (from Pathao merchant dashboard)
PATHAO_STORE_ID=your-store-id

# Optional: Request timeout in milliseconds (default: 30000)
# PATHAO_TIMEOUT=30000

# Optional: Webhook Secret for receiving Pathao events
# PATHAO_WEBHOOK_SECRET=your-webhook-secret

# Usage:
# Only PathaoApiService.fromEnv() reads these variables (since 3.0.0).
# The constructor, fromConfig(), sandbox() and production() use exactly the
# config you pass and never fall back to the environment.
#
# 1. All from environment variables (PATHAO_TIMEOUT included):
#    const pathao = PathaoApiService.fromEnv();
#
# 2. Explicit config, values taken from the environment by you:
#    const pathao = new PathaoApiService({
#      baseURL: process.env.PATHAO_BASE_URL,
#      clientId: process.env.PATHAO_CLIENT_ID,
#      // ... every other field
#    });
